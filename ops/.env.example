# cp .env.example .env 후 값 채우기. .env 는 git에 올리지 않는다.
DB_PASSWORD=autolog
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
GEMINI_API_KEY=
# 카카오 로컬 REST API 키 (developers.kakao.com → 앱 키 → REST API 키, 제품 설정에서 카카오맵 사용 ON)
#  - 운영 웹 장소 주소 → 좌표. 비우면 좌표를 직접 입력
#  - 운행 출발·도착 좌표 → 주소(GET /v1/geo/reverse). 비우면 503 → 차가 내비 주소로 대신한다
KAKAO_REST_KEY=
# 폰이 QR로 접속할 주소, 차가 썸네일을 받을 주소
PUBLIC_BASE_URL=http://localhost
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# 운영자 토큰: 회사·회사 관리자 계정을 만들 때만 쓴다(scripts/ops.sh). 길고 랜덤하게.
# 회사 관리자는 이 토큰이 아니라 각자 이메일·비밀번호로 운영 웹에 로그인한다.
# (예전 이름 ADMIN_TOKEN도 받는다)
OPS_TOKEN=
