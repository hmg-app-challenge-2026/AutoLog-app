<?xml version="1.0" encoding="utf-8"?>
<!-- 로직에 필요한 권한·서비스는 여기 선언한다. app 매니페스트에 자동 병합된다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- [앱 A] F-16 기록 서비스. 위치 권한이 필요한 location 타입 대신 specialUse (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- [앱 A] F-14 부팅 뒤 자동 준비 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- [앱 A] Pleos Vehicle SDK 읽기 권한(AAR @RequiresPermission 확인, sdk-findings). CONTROL_* 권한은 선언하지 않는다. -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />  <!-- Odometer, Gear -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />   <!-- CarInfo(VIN) -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" /> <!-- Fuel -->
    <!-- [앱 A] 시동 상태 IGNITION_STATE (AAOS CarPropertyManager). Pleos 공개 API가 없다 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- AAOS 차속 PERF_VEHICLE_SPEED (움직임 판단). 런타임 권한 — 프론트가 요청한다. 없으면 계기판만으로 판단 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- [앱 B] Fused Location. SDK 1.1.3은 서비스 바인딩 권한(FUSED_LOCATION_BINDING)을 자체 매니페스트로 합친다. 이 런타임 권한은 1.0.4 기준으로 남겨 둔다(요청해도 해 없음) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- [앱 B] NaviHelper. 없으면 initialize가 "Permission [pleos.car.permission.NAVI_ROUTE] is required"로 실패(에뮬레이터 확인) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <application>
        <!-- [앱 A] F-16 백그라운드 기록. 프로세스가 살아 있는 동안 포그라운드 -->
        <service
            android:name="kr.autolog.vehicle.session.TripRecordingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Vehicle trip logging: keeps odometer and gear listeners alive while the driver uses navigation" />
        </service>
        <!-- [앱 A] F-14 부팅·업데이트 뒤 AutoLog 조립(세션 복구·자동 시작) -->
        <receiver
            android:name="kr.autolog.vehicle.session.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
